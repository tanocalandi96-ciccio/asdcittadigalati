---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import NewsCard from "../components/NewsCard.astro";
import NextMatch from "../components/NextMatch.astro";
import SponsorStrip from "../components/SponsorStrip.astro";
import KineticRibbon from "../components/KineticRibbon.astro";
import societa from "../data/societa.json";

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Il claim si scrive dal pannello su piu' righe: ogni riga diventa un a capo.
const righeClaim = societa.claimHome.split(/\r?\n/).filter(Boolean);
---
<Base title="Home">
  <main id="main" tabindex="-1">
    <Hero />

    <section class="news-section" aria-labelledby="news-title">
      <div class="section-inner">
        <h2 id="news-title" class="font-display">Ultime notizie</h2>
        <div class="news-grid">
          {news.map((post) => <NewsCard post={post} />)}
        </div>
        <p class="all-news"><a href="/news">Tutte le news</a></p>
      </div>
    </section>

    <NextMatch />

    <!-- FOTO FITTIZIA generata: sostituire con una foto vera di pubblico al Ducezio -->
    <section class="paese" aria-labelledby="paese-claim">
      <img
        src="/img/foto/tifosi.webp"
        alt="Tifosi di spalle lungo la recinzione del campo, sotto le torri faro accese all'imbrunire"
        width="1600"
        height="894"
        loading="lazy"
      />
      <div class="paese-testo">
        <p id="paese-claim" class="font-display">
          {righeClaim.map((riga, i) => (
            <>{i > 0 && <br />}{riga}</>
          ))}
        </p>
      </div>
    </section>

    <KineticRibbon />

    <SponsorStrip />
  </main>
</Base>
<style>
  /* Fascia a tutta larghezza: la foto porta l'atmosfera, il claim ci sta sopra
     ancorato in basso a sinistra. Nessun contenitore, nessuna card. */
  .paese {
    position: relative;
    isolation: isolate;
  }
  .paese img {
    width: 100%;
    height: clamp(280px, 46vw, 560px);
    object-fit: cover;
    display: block;
  }
  .paese::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--bg) 88%, transparent) 5%,
      transparent 60%
    );
  }
  .paese-testo {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
    max-width: 1200px;
    margin: 0 auto;
  }
  .paese-testo p {
    margin: 0;
    text-transform: uppercase;
    line-height: 1.05;
    font-size: clamp(1.6rem, 5vw, 3.25rem);
    color: var(--text);
    text-shadow: 0 2px 20px color-mix(in oklch, var(--bg) 85%, transparent);
  }
  .news-section {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .news-section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .news-grid > :global(a:first-child) {
      grid-column: span 2;
    }
  }
  .all-news {
    margin: 1.5rem 0 0;
  }
  .all-news a {
    color: var(--oro);
    text-decoration: none;
  }
  .all-news a:hover,
  .all-news a:focus-visible {
    text-decoration: underline;
  }
</style>
