---
// PAGINA DI PROVA temporanea: alternative alla barra sponsor.
// Da cancellare una volta scelta la variante. Non collegata dal menu.
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const livelloOrdine: Record<string, number> = { main: 0, tecnico: 1, partner: 2 };
const sponsors = (await getCollection("sponsor")).sort(
  (a, b) => livelloOrdine[a.data.livello] - livelloOrdine[b.data.livello]
);
const doppio = [...sponsors, ...sponsors];
---
<Base title="Prova sponsor" description="Pagina di prova, non collegata al sito">
  <main id="main" tabindex="-1">
    <section class="intro">
      <h1 class="font-display">Quattro barre sponsor a confronto</h1>
      <p>
        La barra attuale è la numero 0, in fondo, per il paragone diretto.
        Tutte si fermano al passaggio del mouse e rispettano il moto ridotto.
      </p>
    </section>

    <!-- 1. Bordo campo -->
    <section class="demo">
      <h2 class="font-display">1. Bordo campo</h2>
      <p class="nota">
        I loghi corrono su un pannello inclinato in prospettiva, come i cartelloni
        a bordo campo visti dalla tribuna. L'idea più legata al calcio.
      </p>
      <div class="board-wrap">
        <div class="board">
          <div class="board-track">
            {doppio.map((s) => (
              <span class="board-item"><img src={s.data.logo} alt={`Logo ${s.data.nome}`} /></span>
            ))}
          </div>
        </div>
        <div class="board-grass" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 2. Sfocatura progressiva -->
    <section class="demo alt">
      <h2 class="font-display">2. Sfocatura progressiva</h2>
      <p class="nota">
        I loghi si dissolvono nella sfocatura ai due lati invece di sparire di
        netto. Pulito, sobrio, molto "premium".
      </p>
      <div class="pb-wrap">
        <div class="pb-track">
          {doppio.map((s) => (
            <span class="pb-item"><img src={s.data.logo} alt={`Logo ${s.data.nome}`} /></span>
          ))}
        </div>
        <div class="pb-blur left" aria-hidden="true"></div>
        <div class="pb-blur right" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 3. Nastro curvo -->
    <section class="demo">
      <h2 class="font-display">3. Nastro curvo</h2>
      <p class="nota">
        I loghi seguono un arco leggero, come uno striscione teso tra due pali.
        Più giocoso, meno istituzionale.
      </p>
      <div class="arc-wrap">
        <div class="arc-track">
          {doppio.map((s, i) => (
            <span class="arc-item" style={`--k:${i}`}><img src={s.data.logo} alt={`Logo ${s.data.nome}`} /></span>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Muro fermo -->
    <section class="demo alt">
      <h2 class="font-display">4. Muro fermo</h2>
      <p class="nota">
        Niente scorrimento: i loghi stanno fermi in griglia, il principale grande
        e gli altri più piccoli. Si illuminano uno alla volta, a rotazione lenta.
        La scelta più rispettosa verso gli sponsor: nessuno "scappa via".
      </p>
      <div class="wall-grid" data-glow>
        {sponsors.map((s) => (
          <span class:list={["wall-item", s.data.livello]}>
            <img src={s.data.logo} alt={`Logo ${s.data.nome}`} />
          </span>
        ))}
      </div>
    </section>

    <!-- 0. Attuale -->
    <section class="demo current">
      <h2 class="font-display">0. Quella di adesso</h2>
      <p class="nota">Nastro orizzontale, loghi in scala di grigi che tornano a colori al passaggio.</p>
      <div class="now-wrap">
        <div class="now-track">
          {doppio.map((s) => (
            <span class="now-item"><img src={s.data.logo} alt={`Logo ${s.data.nome}`} /></span>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .intro { padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) 0; max-width: 800px; }
  .intro h1 { font-size: clamp(1.8rem, 5vw, 3rem); margin-bottom: 0.75rem; }
  .demo { padding: clamp(2.5rem, 7vw, 4.5rem) 0; }
  .demo > h2, .demo > .nota { padding-inline: clamp(1rem, 4vw, 2.5rem); max-width: 70ch; }
  .demo h2 { font-size: clamp(1.4rem, 3.5vw, 2.2rem); margin-bottom: 0.5rem; }
  .nota { color: color-mix(in oklch, var(--text) 78%, transparent); margin-bottom: 2rem; }
  .demo.alt { background: var(--surface); }

  /* ---- 1. Bordo campo ---- */
  .board-wrap { perspective: 620px; overflow: hidden; }
  .board {
    background: oklch(0.96 0.01 265);
    border-top: 3px solid var(--oro);
    border-bottom: 3px solid var(--oro);
    transform: rotateX(34deg);
    transform-origin: bottom center;
    overflow: hidden;
    box-shadow: 0 22px 40px color-mix(in oklch, var(--bg) 75%, transparent);
  }
  .board-track {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: 1.15rem clamp(1rem, 3vw, 2rem);
    width: max-content;
    animation: scorri 26s linear infinite;
  }
  .board-item img { height: 2.6rem; width: auto; }
  .board-grass {
    height: 44px;
    background:
      linear-gradient(to bottom, oklch(0.42 0.09 145), oklch(0.3 0.07 145));
  }
  .board-wrap:hover .board-track { animation-play-state: paused; }

  /* ---- 2. Sfocatura progressiva ---- */
  .pb-wrap { position: relative; overflow: hidden; background: oklch(0.95 0.01 265); padding: 1.5rem 0; }
  .pb-track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    width: max-content;
    animation: scorri 30s linear infinite;
  }
  .pb-item img { height: 2.8rem; width: auto; }
  .pb-blur {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(60px, 14vw, 170px);
    pointer-events: none;
    backdrop-filter: blur(7px);
  }
  .pb-blur.left {
    left: 0;
    mask-image: linear-gradient(to right, oklch(0 0 0), transparent);
    background: linear-gradient(to right, oklch(0.95 0.01 265), transparent);
  }
  .pb-blur.right {
    right: 0;
    mask-image: linear-gradient(to left, oklch(0 0 0), transparent);
    background: linear-gradient(to left, oklch(0.95 0.01 265), transparent);
  }
  .pb-wrap:hover .pb-track { animation-play-state: paused; }

  /* ---- 3. Nastro curvo ---- */
  .arc-wrap { overflow: hidden; background: oklch(0.95 0.01 265); padding: 2.5rem 0 3rem; }
  .arc-track {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    width: max-content;
    animation: scorri 28s linear infinite;
  }
  /* ogni logo sale/scende secondo una sinusoide sull'indice */
  .arc-item {
    display: block;
    transform: translateY(calc(sin(var(--k) * 0.7rad) * 26px)) rotate(calc(sin(var(--k) * 0.7rad) * -5deg));
  }
  .arc-item img { height: 2.6rem; width: auto; }
  .arc-wrap:hover .arc-track { animation-play-state: paused; }

  /* ---- 4. Muro fermo ---- */
  .wall-grid {
    background: oklch(0.95 0.01 265);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    align-items: center;
    justify-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.75rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem);
  }
  .wall-item img {
    height: 2.2rem;
    width: auto;
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter 0.5s var(--ease-out-quart), opacity 0.5s var(--ease-out-quart), transform 0.5s var(--ease-out-quart);
  }
  .wall-item.main { grid-column: span 2; }
  .wall-item.main img { height: 3.6rem; }
  .wall-item.tecnico img { height: 2.8rem; }
  .wall-item.acceso img,
  .wall-item:hover img {
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.06);
  }

  /* ---- 0. Attuale ---- */
  .now-wrap { overflow: hidden; background: oklch(0.95 0.01 265); padding: 1.75rem 0;
    mask-image: linear-gradient(to right, transparent, oklch(0 0 0) 8%, oklch(0 0 0) 92%, transparent); }
  .now-track { display: flex; align-items: center; gap: clamp(2.5rem, 6vw, 5rem); width: max-content; animation: scorri 32s linear infinite; }
  .now-item img { height: 2.5rem; width: auto; filter: grayscale(1); transition: filter 0.3s var(--ease-out-quart); }
  .now-item:hover img { filter: grayscale(0); }
  .now-wrap:hover .now-track { animation-play-state: paused; }

  @keyframes scorri {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .board-track, .pb-track, .arc-track, .now-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .board { transform: none; }
    .arc-item { transform: none; }
    .wall-item img { transition: none; }
  }
</style>

<script>
  // Muro fermo: accende un logo alla volta, a rotazione lenta.
  const grid = document.querySelector<HTMLElement>("[data-glow]");
  if (grid && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const items = [...grid.querySelectorAll<HTMLElement>(".wall-item")];
    let i = 0;
    setInterval(() => {
      items.forEach((el) => el.classList.remove("acceso"));
      items[i % items.length]?.classList.add("acceso");
      i++;
    }, 1600);
  }
</script>
