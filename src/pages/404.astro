---
// Pagina di errore: Netlify la serve da sola per qualunque indirizzo
// inesistente, purche' il file si chiami 404.html nella cartella pubblicata.
import Base from "../layouts/Base.astro";

const scorciatoie = [
  ["/squadra", "La rosa"],
  ["/stagione", "Classifica e risultati"],
  ["/news", "Ultime notizie"],
  ["/contatti", "Contatti"],
];
---
<Base
  title="Pagina non trovata"
  description="La pagina cercata non esiste o è stata spostata"
>
  <main id="main" tabindex="-1" class="notfound">
    <div class="inner">
      <p class="codice font-display" aria-hidden="true">404</p>
      <h1 class="font-display">Palla fuori</h1>
      <p class="testo">
        La pagina che cercavi non esiste, oppure è stata spostata. Può capitare
        con un link vecchio o un indirizzo scritto a mano.
      </p>
      <ul class="scorciatoie">
        {scorciatoie.map(([href, label]) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
      <p class="torna"><a href="/">Torna alla home</a></p>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner { max-width: 640px; margin: 0 auto; }
  /* Numero grande come un tabellone, non come un titolo. */
  .codice {
    font-size: clamp(4.5rem, 18vw, 9rem);
    line-height: 0.85;
    color: color-mix(in oklch, var(--giallo) 22%, transparent);
    margin: 0 0 0.25rem;
  }
  .notfound h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    margin: 0 0 0.75rem;
  }
  .testo { max-width: 52ch; margin: 0 0 1.75rem; }
  .scorciatoie {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .scorciatoie a {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--oro);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .scorciatoie a:hover,
  .scorciatoie a:focus-visible {
    background: var(--giallo);
    color: var(--bg);
  }
  .torna a { color: var(--giallo); }
</style>
