---
// PAGINA DI PROVA temporanea: tre varianti di carosello 3D per la pagina Squadra.
// Da cancellare una volta scelta la variante. Non e' collegata dal menu.
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const ordine = ["Portiere", "Difensore", "Centrocampista", "Attaccante"];
const players = (await getCollection("giocatori"))
  .sort((a, b) => ordine.indexOf(a.data.ruolo) - ordine.indexOf(b.data.ruolo))
  .slice(0, 9)
  .map((p) => ({
    nome: p.data.nome,
    ruolo: p.data.ruolo,
    numero: p.data.numero ?? null,
    foto: p.data.foto || "/img/silhouette.svg",
  }));
---
<Base title="Prova caroselli" description="Pagina di prova, non collegata al sito">
  <main id="main" tabindex="-1">
    <section class="intro">
      <h1 class="font-display">Tre caroselli a confronto</h1>
      <p>
        Pagina di prova. Ogni variante usa i giocatori veri e i colori del sito.
        Su desktop si trascina col mouse o si usano le frecce della tastiera, su
        telefono si scorre col dito.
      </p>
    </section>

    <!-- VARIANTE A: anello 3D (coverflow) -->
    <section class="demo" aria-labelledby="va">
      <h2 id="va" class="font-display">A. Anello 3D</h2>
      <p class="nota">
        Le schede stanno su un cilindro che ruota. Quella al centro è dritta e a
        fuoco, le altre si allontanano ruotate di lato. Trascina per girare.
      </p>
      <div class="ring-stage" data-ring>
        <div class="ring" data-ring-inner>
          {players.map((p, i) => (
            <article class="card" style={`--i:${i}`}>
              <img src={p.foto} alt="" />
              <div class="card-info">
                {p.numero && <span class="num font-display">{p.numero}</span>}
                <p class="nome font-display">{p.nome}</p>
                <p class="ruolo">{p.ruolo}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="controls">
        <button type="button" data-ring-prev aria-label="Giocatore precedente">‹</button>
        <button type="button" data-ring-next aria-label="Giocatore successivo">›</button>
      </div>
    </section>

    <!-- VARIANTE B: ventaglio di carte -->
    <section class="demo alt" aria-labelledby="vb">
      <h2 id="vb" class="font-display">B. Ventaglio</h2>
      <p class="nota">
        Le schede sono impilate a ventaglio come una mano di carte. Passando
        sopra una scheda, questa si alza e le altre si scostano.
      </p>
      <div class="fan" data-fan>
        {players.slice(0, 7).map((p, i) => (
          <article class="fan-card" style={`--i:${i}; --n:7`} tabindex="0">
            <img src={p.foto} alt="" />
            <div class="card-info">
              {p.numero && <span class="num font-display">{p.numero}</span>}
              <p class="nome font-display">{p.nome}</p>
              <p class="ruolo">{p.ruolo}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- VARIANTE C: parete curva legata allo scroll orizzontale -->
    <section class="demo" aria-labelledby="vc">
      <h2 id="vc" class="font-display">C. Parete curva</h2>
      <p class="nota">
        Fila orizzontale su una curva: le schede ai bordi si inclinano verso
        l'interno, come una parete che avvolge. Si scorre lateralmente.
      </p>
      <div class="wall" data-wall>
        {players.map((p) => (
          <article class="wall-card">
            <img src={p.foto} alt="" />
            <div class="card-info">
              {p.numero && <span class="num font-display">{p.numero}</span>}
              <p class="nome font-display">{p.nome}</p>
              <p class="ruolo">{p.ruolo}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .intro {
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) 0;
    max-width: 800px;
  }
  .intro h1 { font-size: clamp(1.8rem, 5vw, 3rem); margin-bottom: 0.75rem; }
  .demo {
    padding: clamp(2.5rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .demo.alt { background: var(--surface); }
  .demo h2 { font-size: clamp(1.4rem, 3.5vw, 2.2rem); margin-bottom: 0.5rem; }
  .nota { max-width: 62ch; color: color-mix(in oklch, var(--text) 78%, transparent); margin-bottom: 2rem; }

  /* Scheda comune alle tre varianti */
  .card, .fan-card, .wall-card {
    background: var(--surface);
    border: 1px solid color-mix(in oklch, var(--oro) 45%, transparent);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card img, .fan-card img, .wall-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: color-mix(in oklch, var(--bg) 70%, var(--surface));
  }
  .card-info { padding: 0.7rem 0.85rem 0.9rem; position: relative; }
  .num {
    position: absolute;
    top: -1.9rem;
    right: 0.6rem;
    font-size: 2.4rem;
    color: var(--giallo);
    line-height: 1;
    text-shadow: 0 2px 12px color-mix(in oklch, var(--bg) 85%, transparent);
  }
  .nome { font-size: 1rem; margin: 0; }
  .ruolo { font-size: 0.8rem; color: var(--oro); margin: 0.15rem 0 0; }

  /* ---- A. Anello 3D ---- */
  .ring-stage {
    perspective: 1100px;
    height: 420px;
    position: relative;
    cursor: grab;
    touch-action: pan-y;
  }
  .ring-stage:active { cursor: grabbing; }
  .ring {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 210px;
    height: 340px;
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out-quart);
  }
  .ring .card {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * var(--step, 40deg))) translateZ(var(--radius, 340px));
    backface-visibility: hidden;
  }
  .controls { display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.5rem; }
  .controls button {
    background: transparent;
    color: var(--giallo);
    border: 1px solid var(--oro);
    font-size: 1.5rem;
    line-height: 1;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
  }
  .controls button:hover, .controls button:focus-visible { background: var(--giallo); color: var(--bg); }

  /* ---- B. Ventaglio ---- */
  .fan {
    position: relative;
    height: 430px;
    perspective: 1200px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .fan-card {
    position: absolute;
    bottom: 0;
    width: 190px;
    transform-origin: bottom center;
    --angolo: calc((var(--i) - (var(--n) - 1) / 2) * 9deg);
    transform: rotate(var(--angolo)) translateY(0);
    transition: transform 0.45s var(--ease-out-quart), filter 0.45s var(--ease-out-quart);
    filter: brightness(0.72);
  }
  .fan:hover .fan-card { filter: brightness(0.5); }
  .fan-card:hover, .fan-card:focus-visible {
    transform: rotate(var(--angolo)) translateY(-2.5rem) scale(1.06);
    filter: brightness(1);
    z-index: 5;
  }

  /* ---- C. Parete curva ---- */
  .wall {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    perspective: 900px;
    padding: 2rem clamp(1rem, 30vw, 20rem);
    scrollbar-width: thin;
  }
  .wall-card {
    flex: 0 0 200px;
    scroll-snap-align: center;
    transform-style: preserve-3d;
    transition: transform 0.25s linear;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring, .fan-card, .wall-card { transition: none; }
  }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- A. Anello: rotazione con trascinamento, frecce e tastiera ----
  const stage = document.querySelector<HTMLElement>("[data-ring]");
  const ring = document.querySelector<HTMLElement>("[data-ring-inner]");
  if (stage && ring) {
    const cards = ring.querySelectorAll<HTMLElement>(".card");
    const n = cards.length;
    const step = 360 / n;
    // raggio che evita la compenetrazione delle schede
    const radius = Math.round(105 / Math.tan(Math.PI / n));
    ring.style.setProperty("--step", `${step}deg`);
    ring.style.setProperty("--radius", `${radius}px`);

    let angle = 0;
    let dragging = false;
    let startX = 0;
    let startAngle = 0;

    const render = () => { ring.style.transform = `translateZ(-${radius}px) rotateY(${angle}deg)`; };
    render();

    const gira = (dir: number) => { angle -= dir * step; render(); };

    document.querySelector("[data-ring-next]")?.addEventListener("click", () => gira(1));
    document.querySelector("[data-ring-prev]")?.addEventListener("click", () => gira(-1));

    stage.addEventListener("pointerdown", (e) => {
      dragging = true; startX = e.clientX; startAngle = angle;
      ring.style.transition = "none";
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      angle = startAngle + (e.clientX - startX) * 0.35;
      render();
    });
    const finePresa = () => {
      if (!dragging) return;
      dragging = false;
      ring.style.transition = "";
      angle = Math.round(angle / step) * step; // aggancia alla scheda piu' vicina
      render();
    };
    stage.addEventListener("pointerup", finePresa);
    stage.addEventListener("pointercancel", finePresa);

    stage.tabIndex = 0;
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { gira(1); e.preventDefault(); }
      if (e.key === "ArrowLeft") { gira(-1); e.preventDefault(); }
    });
  }

  // ---- C. Parete curva: inclinazione in base alla distanza dal centro ----
  const wall = document.querySelector<HTMLElement>("[data-wall]");
  if (wall && !reduced) {
    const cards = [...wall.querySelectorAll<HTMLElement>(".wall-card")];
    let raf = 0;
    const aggiorna = () => {
      const centro = wall.getBoundingClientRect().left + wall.clientWidth / 2;
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        const d = (r.left + r.width / 2 - centro) / (wall.clientWidth / 2); // -1..1
        const clamp = Math.max(-1.4, Math.min(1.4, d));
        c.style.transform =
          `rotateY(${-clamp * 34}deg) translateZ(${-Math.abs(clamp) * 90}px) scale(${1 - Math.abs(clamp) * 0.12})`;
        c.style.filter = `brightness(${1 - Math.abs(clamp) * 0.45})`;
      }
      raf = 0;
    };
    const pianifica = () => { if (!raf) raf = requestAnimationFrame(aggiorna); };
    wall.addEventListener("scroll", pianifica, { passive: true });
    addEventListener("resize", pianifica);
    pianifica();
  }
</script>
