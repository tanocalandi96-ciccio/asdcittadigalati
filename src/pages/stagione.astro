---
import Base from "../layouts/Base.astro";
import TuttocampoWidget from "../components/TuttocampoWidget.astro";
import Scoreboard from "../components/Scoreboard.astro";
---
<Base title="Stagione" description="Classifica, risultati e calendario del campionato 2026-27 dell'ASD Città di Galati">
  <main id="main" tabindex="-1">
    <section class="intro">
      <div class="inner">
        <h1 class="font-display">Stagione</h1>
        <p class="kicker">
          Classifica, risultati e calendario del campionato 2026-27, aggiornati in automatico da
          Tuttocampo.
        </p>
      </div>
    </section>

    <Scoreboard />

    <section class="widget-section classifica" aria-labelledby="classifica-title">
      <div class="inner">
        <div class="section-heading">
          <span class="section-index font-display" aria-hidden="true">01</span>
          <h2 id="classifica-title" class="font-display">Classifica</h2>
        </div>
        <TuttocampoWidget type="classifica" title="Classifica del girone - widget Tuttocampo" />
      </div>
    </section>

    <section class="widget-section risultati" aria-labelledby="risultati-title">
      <div class="inner">
        <div class="section-heading">
          <span class="section-index font-display" aria-hidden="true">02</span>
          <h2 id="risultati-title" class="font-display">Risultati</h2>
        </div>
        <TuttocampoWidget type="risultati" title="Risultati del campionato - widget Tuttocampo" />
      </div>
    </section>

    <section class="widget-section calendario" aria-labelledby="calendario-title">
      <div class="inner">
        <div class="section-heading">
          <span class="section-index font-display" aria-hidden="true">03</span>
          <h2 id="calendario-title" class="font-display">Calendario</h2>
        </div>
        <TuttocampoWidget type="calendario" title="Calendario del campionato - widget Tuttocampo" />
      </div>
    </section>
  </main>
</Base>
<style>
  .inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .intro {
    padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .intro h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    max-width: 55ch;
  }
  .widget-section {
    background: var(--surface);
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
  }
  .widget-section.risultati,
  .widget-section.calendario {
    border-top: 1px solid color-mix(in oklch, var(--text) 15%, transparent);
  }
  .widget-section.classifica {
    background: color-mix(in oklch, var(--surface) 80%, var(--blu) 20%);
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-bottom: clamp(3rem, 7vw, 4rem);
  }
  .widget-section.calendario {
    padding-bottom: clamp(3.5rem, 8vw, 5.5rem);
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .section-index {
    color: var(--oro);
    font-size: 1.25rem;
  }
  .section-heading h2 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    margin: 0;
  }
  .widget-section.classifica .section-heading h2 {
    font-size: clamp(1.7rem, 4.2vw, 2.5rem);
  }
</style>
