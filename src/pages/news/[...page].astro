---
// Elenco notizie paginato: /news, /news/2, /news/3...
// Con poche notizie la barra di paginazione non compare nemmeno, quindi oggi
// la pagina si comporta esattamente come prima. Serve a non far diventare
// l'elenco una pagina infinita quando gli articoli saranno decine.
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import NewsCard from "../../components/NewsCard.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const news = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(news, { pageSize: 9 });
};

interface Props {
  page: Page<CollectionEntry<"news">>;
}
const { page } = Astro.props;
const titolo = page.currentPage > 1 ? `News, pagina ${page.currentPage}` : "News";
---
<Base title={titolo} description="Tutte le notizie dell'ASD Città di Galati">
  <main id="main" tabindex="-1">
    <section class="news-section" aria-labelledby="news-title">
      <div class="section-inner">
        <h1 id="news-title" class="font-display">News</h1>
        <p class="kicker">
          {page.lastPage > 1
            ? `Tutte le notizie del club, pagina ${page.currentPage} di ${page.lastPage}`
            : "Tutte le notizie del club"}
        </p>

        <div class="banda" aria-hidden="true">
          <img src="/img/ambiente/taccuino.webp" alt="" width="1800" height="764" loading="lazy" />
        </div>

        {page.data.length > 0 ? (
          <div class="news-grid">
            {page.data.map((post) => <NewsCard post={post} />)}
          </div>
        ) : (
          <p>Nessuna notizia pubblicata al momento.</p>
        )}

        {page.lastPage > 1 && (
          <nav class="paginazione" aria-label="Pagine delle notizie">
            {page.url.prev ? (
              <a class="pag-link" href={page.url.prev} rel="prev">&lsaquo; Più recenti</a>
            ) : (
              <span class="pag-link spento" aria-hidden="true">&lsaquo; Più recenti</span>
            )}
            <span class="pag-stato">Pagina {page.currentPage} di {page.lastPage}</span>
            {page.url.next ? (
              <a class="pag-link" href={page.url.next} rel="next">Più vecchie &rsaquo;</a>
            ) : (
              <span class="pag-link spento" aria-hidden="true">Più vecchie &rsaquo;</span>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>
</Base>
<style>
  .news-section {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .news-section h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    margin: 0 0 2rem;
  }
  /* Fascia d'ambiente: immagine generica e definitiva, non un segnaposto.
     In queste pagine una foto della squadra non ha senso (vedi
     public/img/LEGGIMI.md). */
  .banda {
    position: relative;
    margin-bottom: 2rem;
    height: clamp(140px, 22vw, 260px);
    overflow: hidden;
  }
  .banda img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .banda::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--bg) 55%, transparent),
      var(--bg)
    );
  }
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .news-grid > :global(a:first-child) {
      grid-column: span 2;
    }
  }

  .paginazione {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklch, var(--oro) 35%, transparent);
  }
  .pag-link {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.95rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--oro);
  }
  .pag-link:hover,
  .pag-link:focus-visible { background: var(--giallo); color: var(--bg); }
  .pag-link.spento { opacity: 0.3; border-color: color-mix(in oklch, var(--oro) 40%, transparent); }
  .pag-stato { font-size: 0.85rem; color: color-mix(in oklch, var(--text) 70%, transparent); }
</style>
