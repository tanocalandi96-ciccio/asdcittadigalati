---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import NewsCard from "../../components/NewsCard.astro";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="News" description="Tutte le notizie dell'ASD Città di Galati">
  <main>
    <section class="news-section" aria-labelledby="news-title">
      <div class="section-inner">
        <h1 id="news-title" class="font-display">News</h1>
        <p class="kicker">Tutte le notizie del club</p>
        {news.length > 0 ? (
          <div class="news-grid">
            {news.map((post) => <NewsCard post={post} />)}
          </div>
        ) : (
          <p>Nessuna notizia pubblicata al momento.</p>
        )}
      </div>
    </section>
  </main>
</Base>
<style>
  .news-section {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .news-section h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    margin: 0 0 2rem;
  }
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .news-grid > :global(a:first-child) {
      grid-column: span 2;
    }
  }
</style>
