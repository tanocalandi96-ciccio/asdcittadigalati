---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"news">;
}

const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const { Content } = await render(post);
const dateLabel = date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
// Stesso nome della foto nella card (vedi NewsCard.astro): arrivando dalla
// lista, la copertina si trasforma da card a testata dell'articolo.
const nomeTransizione = `news-${post.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---
<Base title={title} description={`Notizia: ${title}`}>
  {/* Barra di avanzamento della lettura + titolo che compare in alto quando
      quello vero e' uscito dallo schermo. */}
  <div class="reading-bar" aria-hidden="true"><span data-reading-fill></span></div>
  <div class="mini-title" data-mini-title aria-hidden="true">
    <span class="font-display">{title}</span>
  </div>

  <main id="main" tabindex="-1">
    {cover && (
      <div class="cover-wrap">
        <img src={cover} alt={coverAlt ?? `Copertina dell'articolo: ${title}`} class="cover" style={`view-transition-name: ${nomeTransizione}`} />
      </div>
    )}
    <article class="article">
      <p class="date">{dateLabel}</p>
      <h1 class="font-display">{title}</h1>
      <div class="body">
        <Content />
      </div>
      <p class="back"><a href="/news">Tutte le news</a></p>
    </article>
  </main>
</Base>
<style>
  /* L'intestazione del sito e' sticky con z-index 50: la barra sta sopra,
     il titolo ridotto appena sotto di essa. */
  .reading-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: color-mix(in oklch, var(--oro) 22%, transparent);
  }
  .reading-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--giallo);
  }
  .mini-title {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 55;
    background: color-mix(in oklch, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in oklch, var(--oro) 35%, transparent);
    padding: 0.55rem clamp(1rem, 4vw, 2.5rem);
    transform: translateY(-110%);
    transition: transform 0.35s var(--ease-out-quart);
  }
  .mini-title.visibile { transform: translateY(0); }
  .mini-title span {
    display: block;
    max-width: 1200px;
    margin: 0 auto;
    font-size: 0.95rem;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-title { transition: none; }
  }
  .cover-wrap {
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article {
    max-width: 70ch;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
  }
  .date {
    color: var(--giallo);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .article h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 2rem;
  }
  .body :global(p) {
    margin: 0 0 1.25rem;
  }
  .body :global(a) {
    color: var(--giallo);
  }
  .body :global(h2) {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    margin: 2rem 0 1rem;
  }
  .back {
    margin-top: 2.5rem;
  }
  .back a {
    color: var(--oro);
    text-decoration: none;
  }
  .back a:hover,
  .back a:focus-visible {
    text-decoration: underline;
  }
</style>
<script>
  // Barra di lettura: percentuale di articolo scorso. Titolo ridotto: compare
  // quando l'h1 vero e' uscito dallo schermo.
  const fill = document.querySelector<HTMLElement>("[data-reading-fill]");
  const mini = document.querySelector<HTMLElement>("[data-mini-title]");
  const article = document.querySelector<HTMLElement>(".article");
  const h1 = document.querySelector<HTMLElement>(".article h1");

  if (fill && article) {
    let raf = 0;
    const calcola = () => {
      const inizio = article.offsetTop;
      const corsa = Math.max(1, article.offsetHeight - innerHeight * 0.35);
      const p = Math.min(1, Math.max(0, (scrollY - inizio + innerHeight * 0.35) / corsa));
      fill.style.width = `${p * 100}%`;
      raf = 0;
    };
    const pianifica = () => { if (!raf) raf = requestAnimationFrame(calcola); };
    addEventListener("scroll", pianifica, { passive: true });
    addEventListener("resize", pianifica);
    calcola();
  }

  if (mini && h1) {
    const io = new IntersectionObserver(
      ([e]) => mini.classList.toggle("visibile", !e.isIntersecting && e.boundingClientRect.top < 0),
      { threshold: 0 }
    );
    io.observe(h1);
  }
</script>
