---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"news">;
}

const { post } = Astro.props;
const { title, date, cover } = post.data;
const { Content } = await render(post);
const dateLabel = date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={title} description={`Notizia: ${title}`}>
  <main>
    {cover && (
      <div class="cover-wrap">
        <img src={cover} alt={`Copertina dell'articolo: ${title}`} class="cover" />
      </div>
    )}
    <article class="article">
      <p class="date">{dateLabel}</p>
      <h1 class="font-display">{title}</h1>
      <div class="body">
        <Content />
      </div>
      <p class="back"><a href="/news">Tutte le news</a></p>
    </article>
  </main>
</Base>
<style>
  .cover-wrap {
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article {
    max-width: 70ch;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
  }
  .date {
    color: var(--giallo);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .article h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 2rem;
  }
  .body :global(p) {
    margin: 0 0 1.25rem;
  }
  .body :global(a) {
    color: var(--giallo);
  }
  .body :global(h2) {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    margin: 2rem 0 1rem;
  }
  .back {
    margin-top: 2.5rem;
  }
  .back a {
    color: var(--oro);
    text-decoration: none;
  }
  .back a:hover,
  .back a:focus-visible {
    text-decoration: underline;
  }
</style>
