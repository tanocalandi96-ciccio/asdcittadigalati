---
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import EmbedConsenso from "../components/EmbedConsenso.astro";

// TAPPE FITTIZIE: inventate per mostrare come si legge la linea del tempo.
// Da sostituire con la storia vera (vedi docs/RICHIESTE-SOCIETA.md, punto 2.4).
const tappe = [
  {
    anno: "1968",
    titolo: "Il primo pallone",
    testo:
      "Un gruppo di amici comincia a giocare sul terreno in salita sopra il paese. Non c'e' ancora una società, solo maglie spaiate e la voglia di sfidare i comuni vicini.",
  },
  {
    anno: "1974",
    titolo: "Nasce la società",
    testo:
      "Prima iscrizione ufficiale al campionato provinciale. I colori scelti sono quelli dello stemma civico: giallo, blu e rosso.",
  },
  {
    anno: "1991",
    titolo: "Il Ducezio-Parafioriti",
    testo:
      "Il paese inaugura il campo sportivo con la tribuna in cemento. Le domeniche di casa diventano un appuntamento fisso per tutto il borgo.",
  },
  {
    anno: "2009",
    titolo: "La promozione",
    testo:
      "La stagione più bella di sempre si chiude con il salto di categoria e una festa in piazza che dura fino a notte.",
  },
  {
    anno: "2026",
    titolo: "Prima Categoria, girone D",
    testo:
      "La società riparte con una rosa rinnovata e un settore giovanile in crescita, con l'obiettivo di restare il punto di riferimento sportivo di Galati Mamertino.",
  },
];

// Coordinate del comune di Galati Mamertino (ME), verificate su Nominatim/OpenStreetMap
// (query "Galati Mamertino" -> lat 38.0315592, lon 14.7725171). Le coordinate esatte del
// campo "Ducezio-Parafioriti" non sono verificabili al momento: la mappa e' centrata sul
// paese, non su un punto preciso del campo.
const mapBbox = "14.7525171,38.0215592,14.7925171,38.0415592";
const mapMarker = "38.0315592,14.7725171";
const osmEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${mapBbox}&layer=mapnik&marker=${mapMarker}`;
const googleMapsUrl = "https://www.google.com/maps/search/?api=1&query=Campo+sportivo+Ducezio-Parafioriti%2C+Galati+Mamertino+ME";
---
<Base title="Club" description="La storia e il campo dell'ASD Città di Galati">
  <main id="main" tabindex="-1">
    <section class="storia">
      <div class="inner">
        <h1 class="font-display">Il Club</h1>
        <!-- TESTO-STORIA FITTIZIO: segnaposto narrativo in attesa del testo reale (vedi docs/RICHIESTE-SOCIETA.md) -->
        <p>
          Il calcio a Galati Mamertino è una storia di piazze, di campetti in salita e di
          domeniche che fermano il paese. L'ASD Città di Galati raccoglie questa eredità:
          una società nata dalla passione di un gruppo di amici e cresciuta fino a diventare
          la casa calcistica di tutto il borgo, dai pulcini ai veterani della tribuna.
        </p>
        <p>
          I colori sociali, il giallo, il blu e il rosso dello stemma, ripresi dallo scudo
          civico con la torre, raccontano il legame con il territorio dei Nebrodi. Ogni
          partita al Ducezio-Parafioriti è più di novanta minuti: è il paese che si ritrova.
        </p>
        <p>
          Oggi il club milita in Prima Categoria con un obiettivo dichiarato: fare bene sul
          campo e continuare a essere un punto di riferimento per i ragazzi di Galati, dentro
          e fuori dal rettangolo di gioco.
        </p>
      </div>
      <!-- FOTO FITTIZIA generata: sostituire con una foto d'archivio vera della societa' -->
      <figure class="storica">
        <img
          src="/img/foto/storica-squadra.webp"
          alt="Formazione storica del club schierata su un campo in terra battuta, fotografia d'epoca in bianco e nero"
          width="1600"
          height="1194"
          loading="lazy"
        />
        <figcaption>Immagine segnaposto: qui andrà una foto d'archivio della società.</figcaption>
      </figure>
    </section>

    <!-- TAPPE FITTIZIE: vedi commento nel frontmatter -->
    <Timeline tappe={tappe} />

    <section class="campo">
      <!-- FOTO FITTIZIA generata: sostituire con una foto vera del Ducezio-Parafioriti -->
      <img
        class="campo-foto"
        src="/img/foto/campo-ducezio.webp"
        alt="Il campo visto dalla recinzione: tribuna in cemento, torri faro e i monti Nebrodi sullo sfondo alla luce del tramonto"
        width="1600"
        height="894"
        loading="lazy"
      />
      <div class="inner">
        <h2 class="font-display">Il campo</h2>
        <p class="campo-nome">Ducezio-Parafioriti</p>
        <p class="campo-indirizzo">Galati Mamertino (ME), Sicilia</p>
        <div class="map-wrap">
          <EmbedConsenso
            src={osmEmbedUrl}
            title="Mappa di Galati Mamertino (ME), comune del campo Ducezio-Parafioriti"
            servizio="OpenStreetMap"
            nota="La mappa è servita da OpenStreetMap: per mostrarla il browser deve collegarsi ai loro server, che registrano l'indirizzo IP. Il campo si trova comunque a Galati Mamertino (ME), e qui sotto c'è il link diretto a Google Maps."
          />
        </div>
        <p class="map-note">
          La mappa è centrata su Galati Mamertino: le coordinate esatte del campo non sono
          ancora verificate.
        </p>
        <a class="maps-link" href={googleMapsUrl} target="_blank" rel="noopener noreferrer">
          Apri in Google Maps
        </a>
      </div>
    </section>
  </main>
</Base>
<style>
  .inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .storia {
    padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }
  .storia h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 1.5rem;
  }
  .storia p {
    max-width: 65ch;
  }
  /* Foto d'archivio: leggermente sfalsata e ruotata, come una stampa appoggiata
     sul tavolo. Rompe la colonna di testo senza diventare una card. */
  .storica {
    max-width: 760px;
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    transform: rotate(-1.1deg);
  }
  .storica img {
    width: 100%;
    height: auto;
    filter: saturate(0.9);
  }
  .storica figcaption {
    font-size: 0.8rem;
    color: var(--oro);
    margin-top: 0.6rem;
    text-align: right;
  }
  .campo {
    background: var(--surface);
    padding: 0 0 clamp(3rem, 7vw, 5rem);
  }
  /* Foto del campo a tutta larghezza: apre la sezione come un'inquadratura,
     senza contenitore attorno. */
  .campo-foto {
    width: 100%;
    height: clamp(220px, 38vw, 440px);
    object-fit: cover;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .campo .inner {
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }
  .campo h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 0 0 1rem;
  }
  .campo-nome {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.15rem;
    color: var(--giallo);
    margin: 0;
  }
  .campo-indirizzo {
    margin: 0.25rem 0 1.5rem;
  }
  .map-wrap {
    aspect-ratio: 16 / 9;
    max-height: 420px;
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  .map-note {
    color: var(--oro);
    font-size: 0.85rem;
    margin: 0.75rem 0 1.25rem;
  }
  .maps-link {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: var(--giallo);
    color: var(--bg);
    font-family: var(--font-display);
    text-decoration: none;
    font-size: 1rem;
  }
  .maps-link:hover,
  .maps-link:focus-visible {
    background: var(--oro);
  }
</style>
