---
// Pagina di atterraggio dopo l'invio del modulo contatti. Senza, Netlify
// mostra la sua schermata standard: fuori dal sito e senza vie d'uscita.
import Base from "../layouts/Base.astro";
---
<Base
  title="Messaggio inviato"
  description="Il messaggio è stato inviato alla segreteria dell'ASD Città di Galati"
>
  <main id="main" tabindex="-1" class="grazie">
    <div class="inner">
      <p class="segno font-display" aria-hidden="true">✓</p>
      <h1 class="font-display">Messaggio inviato</h1>
      <p class="testo">
        Grazie: la società ha ricevuto il messaggio e risponderà appena
        possibile. Se la richiesta è urgente, conviene passare anche dai canali
        social, dove qualcuno legge quasi sempre in giornata.
      </p>
      <ul class="canali">
        <li>
          <a href="https://www.instagram.com/cittadigalati/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </li>
        <li>
          <a href="https://www.facebook.com/c1ttad1galat1/" target="_blank" rel="noopener noreferrer">Facebook</a>
        </li>
      </ul>
      <p class="torna"><a href="/">Torna alla home</a></p>
    </div>
  </main>
</Base>

<style>
  .grazie {
    min-height: 55vh;
    display: flex;
    align-items: center;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner { max-width: 620px; margin: 0 auto; }
  .segno {
    font-size: clamp(3rem, 10vw, 5rem);
    line-height: 1;
    color: var(--giallo);
    margin: 0 0 0.5rem;
  }
  .grazie h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 0.75rem; }
  .testo { max-width: 54ch; margin: 0 0 1.5rem; }
  .canali {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .canali a {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--oro);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .canali a:hover,
  .canali a:focus-visible { background: var(--giallo); color: var(--bg); }
  .torna a { color: var(--giallo); }
</style>
