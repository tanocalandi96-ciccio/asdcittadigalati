---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-club">
      <p class="font-display club-name">ASD Città di Galati</p>
      <p>Galati Mamertino (ME), Sicilia</p>
      <p>Campo sportivo &quot;Ducezio-Parafioriti&quot;</p>
      <p>Prima Categoria Sicilia 2026-27</p>
    </div>
    <div class="footer-social">
      <p class="footer-heading">Seguici</p>
      <ul>
        <li><a href="https://www.instagram.com/cittadigalati/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.facebook.com/c1ttad1galat1/" target="_blank" rel="noopener noreferrer">Facebook</a></li>
      </ul>
    </div>
    <div class="footer-legal">
      <p class="footer-heading">Dati societari</p>
      <!-- DATI-SOCIETA FITTIZI: segnaposto in attesa dei dati reali dalla società (vedi docs/RICHIESTE-SOCIETA.md) -->
      <p>A.S.D. Città di Galati &middot; Via del Municipio 1, 98070 Galati Mamertino (ME)</p>
      <p>C.F. 00000000000 &middot; info@cittadigalati.example</p>
      <p><a href="/privacy">Privacy</a></p>
    </div>
  </div>
  <p class="footer-copy">
    &copy; {year} ASD Città di Galati
    <span class="firma">
      Powered by{" "}
      <a href="https://elevadigital.it" target="_blank" rel="noopener">Eleva Digital</a>
    </span>
  </p>
</footer>
<style>
  .site-footer { background: var(--surface); color: var(--text); padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem) 1.5rem; margin-top: 3rem; }
  .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }
  .club-name { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .footer-club p, .footer-legal p { margin: 0.25rem 0; }
  .footer-heading { font-family: var(--font-display); font-size: 0.95rem; text-transform: uppercase; margin-bottom: 0.5rem; color: var(--giallo); }
  .footer-social ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  a { color: var(--text); }
  a:hover { color: var(--giallo); }
  .footer-copy { text-align: center; max-width: 1200px; margin: 2rem auto 0; padding-top: 1rem; border-top: 1px solid var(--oro); font-size: 0.85rem; }
  /* Firma dello studio: presente ma discreta, va a capo su schermi stretti. */
  .firma { display: inline-block; margin-left: 0.5rem; color: color-mix(in oklch, var(--text) 62%, transparent); }
  .firma::before { content: "·"; margin-right: 0.5rem; }
  .firma a { color: color-mix(in oklch, var(--text) 78%, transparent); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--oro) 55%, transparent); }
  .firma a:hover, .firma a:focus-visible { color: var(--giallo); border-bottom-color: var(--giallo); }
  @media (max-width: 480px) {
    .firma { display: block; margin: 0.4rem 0 0; }
    .firma::before { content: none; }
  }
</style>
