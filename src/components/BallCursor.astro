---
// Cursore-pallone: sostituisce il puntatore su pointer di precisione
// (mouse) con un pallone nei colori dello stemma, che segue, ruota
// e si ingrandisce sugli elementi interattivi.
//
// Overdrive: il pallone insegue il puntatore con una molla leggera (la
// rotazione nasce dalla velocita' reale), un clic e' un "calcio" con
// schiacciamento e spruzzo di zolle d'erba, e i bottoni marcati come
// magnetici attirano il pallone verso il proprio centro.
//
// Geometria: pentagono centrale + 5 spicchi che coprono l'anello
// esterno del cerchio, ritagliati con un clip-path circolare.
---
<div id="ball-cursor" aria-hidden="true">
  <svg viewBox="0 0 36 36" width="36" height="36">
    <defs>
      <clipPath id="ball-clip">
        <circle cx="18" cy="18" r="16.5" />
      </clipPath>
    </defs>
    <circle cx="18" cy="18" r="16.5" fill="var(--text)" stroke="var(--oro)" stroke-width="1.5" />
    <g clip-path="url(#ball-clip)" stroke="oklch(0.22 0.04 264)" stroke-width="0.5" stroke-linejoin="round">
      <path fill="var(--giallo)" d="M18,11 L24.66,15.84 L37.98,11.52 L18,-3 Z" />
      <path fill="var(--blu)" d="M24.66,15.84 L22.11,23.66 L30.33,34.98 L37.98,11.52 Z" />
      <path fill="var(--rosso)" d="M22.11,23.66 L13.89,23.66 L5.67,34.98 L30.33,34.98 Z" />
      <path fill="var(--blu)" d="M13.89,23.66 L11.34,15.84 L-1.98,11.52 L5.67,34.98 Z" />
      <path fill="var(--giallo)" d="M11.34,15.84 L18,11 L18,-3 L-1.98,11.52 Z" />
      <path fill="oklch(0.22 0.04 264)" d="M18,11 L24.66,15.84 L22.11,23.66 L13.89,23.66 L11.34,15.84 Z" />
    </g>
  </svg>
</div>
<canvas id="ball-fx" aria-hidden="true"></canvas>
<style>
  #ball-cursor { position: fixed; left: 0; top: 0; z-index: 9999; pointer-events: none; display: none; will-change: transform; filter: drop-shadow(0 2px 6px oklch(0.1 0.04 265 / 0.5)); }
  #ball-fx { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 9998; pointer-events: none; display: none; }
  :global(body.ball-cursor-on), :global(body.ball-cursor-on a), :global(body.ball-cursor-on button), :global(body.ball-cursor-on [role="button"]), :global(body.ball-cursor-on input), :global(body.ball-cursor-on textarea), :global(body.ball-cursor-on summary) { cursor: none !important; }
</style>
<script>
  const fine = matchMedia("(pointer: fine)").matches;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (fine && !reduced) {
    const el = document.getElementById("ball-cursor")!;
    const fx = document.getElementById("ball-fx") as HTMLCanvasElement;
    document.body.classList.add("ball-cursor-on");
    el.style.display = "block";
    fx.style.display = "block";

    const ctx = fx.getContext("2d")!;
    function sizeFx() {
      fx.width = innerWidth * devicePixelRatio;
      fx.height = innerHeight * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }
    sizeFx();
    addEventListener("resize", sizeFx);

    // Stato: il pallone insegue il mouse con una molla leggera; la rotazione
    // e lo squash derivano dalla velocita' reale del pallone, non del mouse.
    let mx = innerWidth / 2, my = innerHeight / 2;
    let bx = mx, by = my, vx = 0, vy = 0, rot = 0;
    let hoverScale = 1, kick = 0;
    let magnet: DOMRect | null = null;

    addEventListener("mousemove", (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });

    const interactive = (t: EventTarget | null) =>
      t instanceof Element && t.closest("a, button, [role='button'], input, textarea, summary");
    // Magnetici: i bottoni "pieni" del sito attirano il pallone al centro.
    const magnetic = (t: EventTarget | null) =>
      t instanceof Element && t.closest(".cta, .tuttocampo-link, button[type='submit']");
    addEventListener("mouseover", (e) => {
      if (interactive(e.target)) hoverScale = 1.8;
      const m = magnetic(e.target);
      if (m) magnet = (m as Element).getBoundingClientRect();
    });
    addEventListener("mouseout", (e) => {
      if (interactive(e.target)) hoverScale = 1;
      if (magnetic(e.target)) magnet = null;
    });
    addEventListener("scroll", () => { magnet = null; }, { passive: true });

    // Zolle d'erba: particelle canvas spawnate dal calcio.
    type Blade = { x: number; y: number; vx: number; vy: number; life: number; hue: number };
    const blades: Blade[] = [];
    addEventListener("mousedown", () => {
      kick = 1;
      const n = 10 + Math.floor(Math.random() * 5);
      for (let i = 0; i < n; i++) {
        const a = Math.PI + Math.PI * Math.random(); // ventaglio verso l'alto
        const sp = 3 + Math.random() * 5;
        blades.push({
          x: bx, y: by + 10,
          vx: Math.cos(a + Math.PI / 2) * sp * (Math.random() < 0.5 ? 1 : -1),
          vy: Math.sin(a) * sp * 0.9 - 2,
          life: 1,
          hue: 120 + Math.random() * 30,
        });
      }
    });

    function frame() {
      // molla verso il mouse (o verso il centro del bottone magnetico)
      let tx = mx, ty = my;
      if (magnet) {
        tx = mx * 0.35 + (magnet.left + magnet.width / 2) * 0.65;
        ty = my * 0.35 + (magnet.top + magnet.height / 2) * 0.65;
      }
      vx = (vx + (tx - bx) * 0.25) * 0.62;
      vy = (vy + (ty - by) * 0.25) * 0.62;
      bx += vx; by += vy;
      rot += vx * 0.9;
      kick *= 0.85;

      // squash & stretch: schiacciato dal calcio, allungato dalla velocita'
      const speed = Math.min(1, Math.hypot(vx, vy) / 40);
      const sx = 1 + speed * 0.18 + kick * 0.25;
      const sy = 1 - speed * 0.14 - kick * 0.3;
      el.style.transform =
        `translate(${bx - 18}px, ${by - 18}px) rotate(${rot}deg) scale(${hoverScale * sx}, ${hoverScale * sy})`;

      // particelle erba
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      for (let i = blades.length - 1; i >= 0; i--) {
        const b = blades[i];
        b.vy += 0.35; b.x += b.vx; b.y += b.vy; b.life -= 0.025;
        if (b.life <= 0) { blades.splice(i, 1); continue; }
        ctx.save();
        ctx.translate(b.x, b.y);
        ctx.rotate(Math.atan2(b.vy, b.vx));
        ctx.fillStyle = `hsl(${b.hue} 45% ${28 + b.life * 20}% / ${b.life})`;
        ctx.fillRect(-3, -1, 6, 2);
        ctx.restore();
      }
      requestAnimationFrame(frame);
    }
    frame();
  }
</script>
