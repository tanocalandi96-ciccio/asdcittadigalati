---
import TuttocampoWidget from "./TuttocampoWidget.astro";
---
<section class="next-match" aria-labelledby="next-match-title">
  <div class="inner">
    <h2 id="next-match-title" class="font-display">Prossima partita</h2>
    <TuttocampoWidget type="prossimaPartita" title="Prossima partita - widget Tuttocampo" />
  </div>
</section>
<style>
  .next-match {
    background: var(--surface);
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .next-match h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 0 0 1.5rem;
  }
</style>
