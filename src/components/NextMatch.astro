---
import { WIDGET_URLS, TEAM_PAGE } from "../lib/tuttocampo";

// "calendario" e' il widget Tuttocampo che mostra le prossime partite.
const widgetUrl = WIDGET_URLS.calendario;
---
<section class="next-match" aria-labelledby="next-match-title">
  <div class="inner">
    <h2 id="next-match-title" class="font-display">Prossima partita</h2>

    {widgetUrl ? (
      <>
        <div class="widget-box" id="widget-box">
          <iframe
            id="tuttocampo-widget"
            src={widgetUrl}
            title="Calendario prossima partita - widget Tuttocampo"
            loading="lazy"
          ></iframe>
        </div>
        <p class="fallback-text hidden" id="widget-fallback-text">
          Il widget non è al momento disponibile.
          <a href={TEAM_PAGE} target="_blank" rel="noopener noreferrer">Scheda su Tuttocampo</a>
        </p>
        <script>
          const box = document.getElementById("widget-box");
          const iframe = document.getElementById("tuttocampo-widget") as HTMLIFrameElement | null;
          const fallbackText = document.getElementById("widget-fallback-text");
          let loaded = false;
          iframe?.addEventListener("load", () => { loaded = true; });
          window.setTimeout(() => {
            if (!loaded) {
              box?.classList.add("widget-failed");
              fallbackText?.classList.remove("hidden");
            }
          }, 4000);
        </script>
      </>
    ) : (
      <div class="fallback-block">
        <p class="kicker">Calendario in aggiornamento</p>
        <p>
          Il calendario del prossimo turno è in aggiornamento: i gironi di Prima Categoria per la
          stagione 2026-27 non sono ancora stati resi noti dalla FIGC. Non appena pubblicati, qui
          trovi la prossima partita in automatico.
        </p>
        <a class="tuttocampo-link" href={TEAM_PAGE} target="_blank" rel="noopener noreferrer">
          Scheda su Tuttocampo
        </a>
      </div>
    )}
  </div>
</section>
<style>
  .next-match {
    background: var(--surface);
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .next-match h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 0 0 1.5rem;
  }
  .widget-box iframe {
    width: 100%;
    min-height: 400px;
    border: none;
  }
  .fallback-text.hidden {
    display: none;
  }
  .fallback-block {
    background: var(--bg);
    border-radius: 4px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .kicker {
    color: var(--giallo);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  .fallback-block p:not(.kicker) {
    max-width: 55ch;
    margin: 0 auto 1.5rem;
    color: var(--text);
  }
  .tuttocampo-link {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: var(--giallo);
    color: var(--bg);
    font-family: var(--font-display);
    text-decoration: none;
    font-size: 1rem;
  }
  .tuttocampo-link:hover,
  .tuttocampo-link:focus-visible {
    background: var(--oro);
  }
</style>
