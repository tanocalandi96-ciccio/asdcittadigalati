---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"news">;
}
const { post } = Astro.props;
const { title, date, cover } = post.data;
const dateLabel = date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
---
<article class="news-card" class:list={{ "no-cover": !cover }}>
  {cover && <img src={cover} alt="" class="cover" />}
  <div class="scrim" aria-hidden="true"></div>
  <div class="content">
    <p class="date">{dateLabel}</p>
    <h3>{title}</h3>
  </div>
</article>
<style>
  .news-card {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
  }
  .no-cover {
    background: var(--blu);
  }
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in oklch, var(--bg) 92%, transparent) 0%, transparent 65%);
  }
  .no-cover .scrim {
    display: none;
  }
  .content {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .date {
    color: var(--giallo);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0 0 0.35rem;
  }
  .news-card h3 {
    color: var(--text);
    font-size: clamp(1.15rem, 2.6vw, 1.7rem);
    margin: 0;
  }
</style>
