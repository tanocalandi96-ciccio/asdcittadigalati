---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"news">;
}
const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const dateLabel = date.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
// Stesso nome sulla copertina dell'articolo: nel cambio pagina la foto della
// card si trasforma in quella grande (View Transitions). Il nome deve essere
// un identificatore CSS valido e unico nella pagina: deriva dallo slug.
const nomeTransizione = `news-${post.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---
<a href={`/news/${post.id}/`} class="news-card" class:list={{ "no-cover": !cover }}>
  {cover && <img src={cover} alt={coverAlt ?? ""} class="cover" loading="lazy" style={`view-transition-name: ${nomeTransizione}`} />}
  <div class="scrim" aria-hidden="true"></div>
  <div class="content">
    <p class="date">{dateLabel}</p>
    <h3>{title}</h3>
  </div>
</a>
<style>
  .news-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out-quart);
  }
  .news-card:hover,
  .news-card:focus-visible {
    transform: translateY(-2px);
  }
  .no-cover {
    aspect-ratio: 16 / 9;
    max-height: 320px;
    background: var(--surface);
    display: flex;
    align-items: center;
  }
  .no-cover .content {
    position: static;
    width: 100%;
  }
  .no-cover h3 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in oklch, var(--bg) 92%, transparent) 0%, transparent 65%);
  }
  .no-cover .scrim {
    display: none;
  }
  .content {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .date {
    color: var(--giallo);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0 0 0.35rem;
  }
  .news-card h3 {
    color: var(--text);
    font-size: clamp(1.15rem, 2.6vw, 1.7rem);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .news-card {
      transition: none;
    }
  }
</style>
